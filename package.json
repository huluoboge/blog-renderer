{
  "name": "blog-renderer",
  "version": "0.2.0",
  "description": "模块化 Markdown 博客渲染器：crossnote (markdown-preview-enhanced 核心引擎) + KaTeX 公式 + 站点骨架，渲染核心与站点生成分离",
  "main": "src/index.js",
  "bin": {
    "blog-renderer": "./src/cli.js"
  },
  "scripts": {
    "render": "node src/cli.js",
    "build": "node src/cli.js build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:formula": "node examples/render-formula-test.js"
  },
  "dependencies": {
    "crossnote": "^0.9.31",
    "front-matter": "^4.0.2",
    "fs-extra": "^11.2.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@vitest/coverage-istanbul": "^2.1.9",
    "vitest": "^2.1.9"
  },
  "license": "MIT"
}
